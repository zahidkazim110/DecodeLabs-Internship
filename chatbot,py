# ==========================
# CHATBOT RESPONSE
# ==========================

def get_response(msg):

    msg = msg.lower().strip()

    if msg == "date":
        return f"📅 Today's Date: {datetime.now().strftime('%d-%m-%Y')}"

    if msg == "time":
        return f"⏰ Current Time: {datetime.now().strftime('%H:%M:%S')}"

    if msg.startswith("add"):
        try:
            _, a, b = msg.split()
            return f"➕ Result = {float(a)+float(b)}"
        except:
            return "Usage: add 10 20"

    if msg.startswith("subtract"):
        try:
            _, a, b = msg.split()
            return f"➖ Result = {float(a)-float(b)}"
        except:
            return "Usage: subtract 20 10"

    if msg.startswith("multiply"):
        try:
            _, a, b = msg.split()
            return f"✖️ Result = {float(a)*float(b)}"
        except:
            return "Usage: multiply 5 6"

    if msg.startswith("divide"):
        try:
            _, a, b = msg.split()

            if float(b) == 0:
                return "❌ Cannot divide by zero."

            return f"➗ Result = {float(a)/float(b)}"
        except:
            return "Usage: divide 20 4"

    return responses.get(
        msg,
        "🤖 Sorry, I don't understand that."
    )

# ==========================
# SEND MESSAGE
# ==========================

def send_message(event=None):

    message = entry.get().strip()

    if not message:
        return

    chat_box.config(state=NORMAL)

    chat_box.insert(
        END,
        f"\n🧑 You:\n{message}\n\n",
        "user"
    )

    response = get_response(message)

    chat_box.insert(
        END,
        f"🤖 SmartBot:\n{response}\n\n",
        "bot"
    )

    chat_box.config(state=DISABLED)

    chat_box.see(END)

    entry.delete(0, END)

# ==========================
# MAIN WINDOW
# ==========================

root = Tk()
root.title("SmartBot AI Assistant")
